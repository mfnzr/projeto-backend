<div class="card col-md-6">
    <div class="card-body">
        <h2 class="h4 card-title"><?= htmlspecialchars($product->name) ?></h2>
        <p class="card-text text-muted">
            <?= $product->description ? nl2br(htmlspecialchars($product->description)) : 'Sem descrição.' ?>
        </p>

        <div class="d-flex gap-2">
            <a href="<?= route('products.edit', ['id' => $product->id]) ?>" class="btn btn-outline-primary">
