<input type="hidden" name="sale[order_id]" value="<?= $sale->order_id ?>">

<?php if ($sale->errors('items')) : ?>
    <div class="alert alert-danger"><?= $sale->errors('items') ?></div>
<?php endif; ?>

<?php if (empty($productions)) : ?>
    <div class="alert alert-info">
        Nenhum produto foi para o forno hoje.
        <a href="<?= route('productions.new') ?>">Faça a abertura do dia</a> antes de vender.
    </div>
<?php else : ?>
    <p class="text-muted">Pese cada produto na balança e digite o valor que ela mostrou. O sistema calcula o peso.</p>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Produto</th>
                    <th>Preço por kg</th>
                    <?php if (!$fixedQuantities) : ?>
                        <th>Disponível</th>
                    <?php endif; ?>
                    <th style="width: 9rem;">Unidades</th>
                    <th style="width: 12rem;">Valor da balança (R$)</th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($productions as $production) : ?>
                    <?php $productId = $production->product_id; ?>
                    <?php $error = $sale->errors('item_' . $productId); ?>
                    <tr>
                        <td>
                            <?= htmlspecialchars($production->product->name) ?>
                            <?php if ($error) : ?>
                                <div class="text-danger small"><?= $error ?></div>
                            <?php endif; ?>
                        </td>
                        <td>R$ <?= number_format((float) $production->price_per_kg, 2, ',', '.') ?></td>
                        <?php if ($fixedQuantities) : ?>
                            <td><?= $sale->quantityOf($productId) ?></td>
                        <?php else : ?>
                            <td><?= $production->available() ?></td>
                            <td>
                                <input type="number" step="1" name="items[<?= $productId ?>][quantity]"
                                    aria-label="Unidades de <?= htmlspecialchars($production->product->name) ?>"
                                    class="form-control <?= $error ? 'is-invalid' : '' ?>"
                                    value="<?= htmlspecialchars((string) $sale->quantityOf($productId)) ?>">
                            </td>
                        <?php endif; ?>
                        <td>
                            <input type="number" step="0.01" name="items[<?= $productId ?>][amount]"
                                aria-label="Valor da balança de <?= htmlspecialchars($production->product->name) ?>"
                                class="form-control <?= $error ? 'is-invalid' : '' ?>"
                                value="<?= htmlspecialchars((string) $sale->amountOf($productId)) ?>">
                        </td>
                    </tr>
                <?php endforeach; ?>
            </tbody>
        </table>
    </div>

    <div class="mb-3">
        <p class="form-label mb-1">Forma de pagamento</p>
        <?php foreach (\App\Models\Sale::PAYMENT_METHODS as $value => $label) : ?>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="sale[payment_method]" id="payment_<?= $value ?>"
                    value="<?= $value ?>" <?= $sale->payment_method === $value ? 'checked' : '' ?>>
                <label class="form-check-label" for="payment_<?= $value ?>"><?= $label ?></label>
            </div>
        <?php endforeach; ?>
        <?php if ($sale->errors('payment_method')) : ?>
            <div class="text-danger small"><?= $sale->errors('payment_method') ?></div>
        <?php endif; ?>
    </div>
<?php endif; ?>

<div class="d-flex gap-2">
    <button type="submit" class="btn btn-danger">Salvar</button>
    <a href="<?= route('sales.index') ?>" class="btn btn-outline-secondary">Voltar</a>
</div>
