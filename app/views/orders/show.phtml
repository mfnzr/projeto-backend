            <div class="input-group mb-2">
                <select id="side_dish_select" class="form-select">
                    <?php foreach ($sideDishes as $sideDish) : ?>
                        <option value="<?= $sideDish->id ?>"><?= htmlspecialchars($sideDish->name) ?></option>
                    <?php endforeach; ?>
                </select>
                <button type="button" id="add_side_dish" class="btn btn-outline-success"
