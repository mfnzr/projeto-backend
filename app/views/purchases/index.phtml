        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Data</th>
                    <th>Produto</th>
                    <th>Unidades</th>
                    <th>Valor total</th>
                    <th>Peso</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($purchases as $purchase) : ?>
                    <tr>
                        <td><?= $purchase->id ?></td>
                        <td><?= date('d/m/Y', strtotime($purchase->purchase_date)) ?></td>
                        <td><?= htmlspecialchars($purchase->product->name) ?></td>
                        <td><?= $purchase->quantity ?></td>
                        <td>R$ <?= number_format((float) $purchase->total_amount, 2, ',', '.') ?></td>
